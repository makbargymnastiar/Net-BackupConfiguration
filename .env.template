# Oxidized 认证配置
# 敏感信息：.env 已被 gitignore，切勿提交真实密码
OXIDIZED_USER=admin
OXIDIZED_PASSWORD=YourStrongPassword123

# Flask/Node Manager 配置
# Node Manager 默认 admin 用户密码（首次部署自动创建）
ADMIN_DEFAULT_PASSWORD=admin123

# Flask 配置
FLASK_ENV=production
# Flask session 签名密钥，必须设置为随机长字符串
# 生成方法: openssl rand -hex 32
SECRET_KEY=ChangeMeGenerateRandom64Hex
