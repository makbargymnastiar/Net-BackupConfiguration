# Oxidized 认证配置
# 敏感信息：.env 已被 gitignore，切勿提交真实密码
OXIDIZED_USER=admin
OXIDIZED_PASSWORD=YourStrongPassword123

# Flask/Node Manager 配置
# Node Manager 默认 admin 用户密码（首次部署自动创建）
ADMIN_DEFAULT_PASSWORD=admin123

# Flask 配置
FLASK_ENV=production
# Flask session 签名密钥 ——【必填】。
# 未设置时 docker compose 会直接报错拒绝启动（空 SECRET_KEY 会导致登录 500：
# "The session is unavailable because no secret key was set"）。
# 生成方法: openssl rand -hex 32
# 本文件复制为 .env 后必须替换成真实随机值，.env 永不提交到 Git
SECRET_KEY=REPLACE_ME_RUN__openssl_rand_hex_32__
